<div id="game-container">
  <h2>Pawn Chess</h2>

  <div>
    <button onclick="createNewGame()">Start New Game</button>
    <span style="margin: 0 15px; color: #ccc;">|</span>
    <input type="number" id="resume-id-input" placeholder="Enter Game ID" style="width: 100px; padding: 4px;">
    <button onclick="resumeGame()">Resume Game</button>
  </div>

  <hr>
  <h3>Game ID: <span id="game-id">None (Start or Resume a game)</span></h3>
  <h4 id="turn-indicator">Turn: —</h4>
  <h4 id="status-indicator">Status: —</h4>

  <div id="chess-board" style="display: grid; grid-template-columns: repeat(8, 50px); grid-template-rows: repeat(8, 50px); width: 400px; height: 400px; border: 2px solid black; margin-top: 20px;"></div>
</div>

<script>
    let currentGameId = null;
    let selectedSquare = null;
    let boardState = [];

    // POST /api/games
    async function createNewGame() {
        const res = await fetch('/api/games', { method: 'POST', headers: {'Content-Type': 'application/json'} });
        const data = await res.json();
        currentGameId = data.id;
        updateUI(data);
    }

    // GET /api/games/:id (NEW FEATURE)
    async function resumeGame() {
        const gameId = document.getElementById('resume-id-input').value;
        if (!gameId) {
            alert("Please enter a valid Game ID to resume.");
            return;
        }

        const res = await fetch(`/api/games/${gameId}`);
        if (res.ok) {
            const data = await res.json();
            currentGameId = data.id;
            updateUI(data);
            document.getElementById('resume-id-input').value = ''; // clear input
        } else {
            alert(`Game ID ${gameId} not found. Could not resume.`);
        }
    }

    function updateUI(game) {
        document.getElementById('game-id').innerText = game.id;
        document.getElementById('turn-indicator').innerText = `Turn: ${game.turn === 'W' ? 'White' : 'Black'}`;

        let statusText = `Status: ${game.status.toUpperCase()}`;
        if (game.winner) {
            statusText += ` (Winner: ${game.winner === 'W' ? 'White' : 'Black'})`;
        }
        document.getElementById('status-indicator').innerText = statusText;

        boardState = game.board;
        renderBoard();
    }

    function renderBoard() {
        const boardDiv = document.getElementById('chess-board');
        boardDiv.innerHTML = '';

        for (let r = 0; r < 8; r++) {
            for (let c = 0; c < 8; c++) {
                const square = document.createElement('div');
                square.style.width = '50px';
                square.style.height = '50px';
                square.style.display = 'flex';
                square.style.alignItems = 'center';
                square.style.justifyContent = 'center';
                square.style.fontSize = '24px';
                square.style.cursor = 'pointer';

                // Highlight selected square vs alternate board coloring
                if (selectedSquare && selectedSquare.r === r && selectedSquare.c === c) {
                    square.style.backgroundColor = '#baca44'; // Yellow highlight
                } else {
                    square.style.backgroundColor = (r + c) % 2 === 0 ? '#eeeed2' : '#769656';
                }

                const piece = boardState[r][c];
                if (piece === 'W') square.innerText = '♙';
                if (piece === 'B') square.innerText = '♟';

                square.onclick = () => handleSquareClick(r, c);
                boardDiv.appendChild(square);
            }
        }
    }

    async function handleSquareClick(r, c) {
        if (!currentGameId) {
            alert("Please start a new game or resume an existing one first.");
            return;
        }

        if (!selectedSquare) {
            // Pick up a piece matching the current turn
            if (boardState[r][c] !== null) {
                selectedSquare = { r, c };
                renderBoard(); // re-render to show selection highlight
            }
        } else {
            // Deselect if clicking the same square
            if (selectedSquare.r === r && selectedSquare.c === c) {
                selectedSquare = null;
                renderBoard();
                return;
            }

            // Send move to API
            const res = await fetch(`/api/games/${currentGameId}/move`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ from_r: selectedSquare.r, from_c: selectedSquare.c, to_r: r, to_c: c })
            });

            const data = await res.json();
            if (res.ok) {
                updateUI(data);
            } else {
                alert(data.error);
            }
            selectedSquare = null;
        }
    }
</script>